# ── Identity ──────────────────────────────────────────────────────────────────
# Host user/group IDs so container-written files are owned by you, not root.
# Run: id -u && id -g
UID=1000
GID=1000

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# ── Network ───────────────────────────────────────────────────────────────────
# Host port the web UI is served on.
PORT=8000

# ── Paths ─────────────────────────────────────────────────────────────────────
# Host directory for new (untagged/unsorted) comics dropped for import.
UNTAGGED_DIR=./untagged

# Host directory for the organised library output.
LIBRARY_DIR=./Comics

# ── Docker image ──────────────────────────────────────────────────────────────
IMAGE_REPO=ghcr.io/youruser
IMAGE_TAG=latest
