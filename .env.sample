# ── Identity ──────────────────────────────────────────────────────────────────
# Host user/group IDs so container-written files are owned by you, not root.
# Run: id -u && id -g
UID=1000
GID=1000

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# Comma-separated hostnames the web UI may be accessed on.
# Add your server's IP or domain if you open ComicManager from another machine.
# Default: localhost,127.0.0.1
#ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50

# Comma-separated origins (with https://) allowed to submit forms, needed when
# ComicManager is served over HTTPS behind a reverse proxy (Traefik, nginx, ...).
# Default: none
#CSRF_TRUSTED_ORIGINS=https://comicmanager.example.com

# ── Network ───────────────────────────────────────────────────────────────────
# Host port the web UI is served on.
PORT=8381

# ── Paths ─────────────────────────────────────────────────────────────────────
# HOST paths used by docker-compose for volume mounts only.
# These are NOT read by Django — the container-side paths are always fixed
# regardless of what you set here.

# Host directory for new (untagged/unsorted) comics dropped for import.
UNTAGGED_DIR=./untagged

# Host directory for the organised library output.
LIBRARY_DIR=./Comics

# Optional local scraping data sources. These are only used if you also
# uncomment the matching volume mounts in docker-compose.yml.
# See the Scraping guide for what each file does and where to get it.
#CV_DB_PATH=./data/comicvine.db
#CV_MCL_PATH=./data/latest.mcl
#INDUCKS_DB_PATH=./data/inducks.db


# ── Docker image ──────────────────────────────────────────────────────────────
IMAGE_REPO=gitea.baerentsen.space/frederikbaerentsen
IMAGE_TAG=latest
